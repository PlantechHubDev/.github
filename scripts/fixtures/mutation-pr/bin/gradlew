#!/usr/bin/env bash
# Stub ./gradlew for scripts/test-mutation-pr.sh. Appends its argv to $GRADLE_LOG and acts
# out one PIT outcome from $GRADLE_MODE, printing a log copied from real runs:
#   ok         prints pit-ok.log, writes build/reports/pitest/mutations.xml (with survivors), exit 0
#   nomut      prints pit-no-mutations.log, writes no report, exit 0
#   green      prints pit-green-suite.log, writes no report, exit 1
#   noreport   prints pit-ok.log, writes no report, exit 0
#   okfail     prints pit-ok.log, writes the report, exit 1 (Gradle fails after PIT)
# A comma-separated GRADLE_MODE gives one mode per call, in order ("nomut,green").
M=${MUTATION_FIX:?}
n=$(wc -l < "${GRADLE_LOG:?}" | tr -d ' ')
echo "$*" >> "$GRADLE_LOG"
IFS=, read -r -a modes <<< "${GRADLE_MODE:?}"
mode=${modes[$n]:-${modes[-1]}}
case "$mode" in
  ok) cat "$M/pit-ok.log"; mkdir -p build/reports/pitest; cp "$M/mutations.xml" build/reports/pitest/mutations.xml ;;
  nomut) cat "$M/pit-no-mutations.log" ;;
  green) cat "$M/pit-green-suite.log"; exit 1 ;;
  noreport) cat "$M/pit-ok.log" ;;
  okfail) cat "$M/pit-ok.log"; mkdir -p build/reports/pitest; cp "$M/mutations.xml" build/reports/pitest/mutations.xml; exit 1 ;;
  *) echo "stub gradlew: unknown mode $mode" >&2; exit 9 ;;
esac
