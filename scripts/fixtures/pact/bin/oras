#!/usr/bin/env bash
# Stub for `oras`, used by scripts/test-pact.sh. Appends each call's argv (one line) to
# $FAKE_ORAS_LOG. `pull <host>/<org>/<pkg>:<tag> -o <dir>` copies $FAKE_ORAS_STORE/<pkg>/* into
# <dir>, unless <pkg> is listed in $FAKE_ORAS_NOT_FOUND, $FAKE_ORAS_UNKNOWN, $FAKE_ORAS_DENIED or $FAKE_ORAS_BROKEN,
# which fail the way the registry client does. The out dir is created only on a successful
# pull, as oras does. `repo tags <ref>` prints the first column of $FAKE_ORAS_STORE/<pkg>.tags ("<tag> <created>" lines),
# `manifest fetch <pkg>:<tag>` prints a manifest whose annotation org.opencontainers.image.created is that
# line's second column. `login` just drains stdin.
echo "$*" >> "${FAKE_ORAS_LOG:?}"
cmd=${1:-}
case "$cmd" in
  login) cat >/dev/null; exit 0 ;;
  repo|manifest)
    ref=""
    for a in "$@"; do case "$a" in ghcr.io/*) ref=$a ;; esac; done
    pkg=${ref#*/*/}; pkg=${pkg%%:*}
    tags=${FAKE_ORAS_STORE:?}/$pkg.tags
    [ -f "$tags" ] || { echo "Error: $ref: not found" >&2; exit 1; }
    if [ "$cmd $2" = "repo tags" ]; then cut -d' ' -f1 "$tags"
    elif [ "$cmd $2" = "manifest fetch" ]; then
      [ -z "${FAKE_ORAS_MANIFEST_DENIED:-}" ] || { echo "Error response from registry: denied: requested access to the resource is denied" >&2; exit 1; }
      tag=${ref##*:}
      created=$(awk -v t="$tag" '$1 == t { print $2 }' "$tags")
      printf '{"schemaVersion":2,"annotations":{"org.opencontainers.image.created":"%s"}}\n' "$created"
    else echo "stub oras: unrecognised call: $*" >&2; exit 1; fi ;;
  push) exit 0 ;;
  pull)
    ref=""; out=""; prev=""
    for a in "$@"; do
      [ "$prev" = "-o" ] && out=$a
      case "$a" in ghcr.io/*) ref=$a ;; esac
      prev=$a
    done
    pkg=${ref#*/*/}; pkg=${pkg%%:*}
    in_list() { case " $1 " in *" $pkg "*) return 0 ;; *) return 1 ;; esac; }
    if in_list "${FAKE_ORAS_CMDNOTFOUND:-}"; then
      echo "oras: command not found" >&2; exit 127
    elif in_list "${FAKE_ORAS_NOT_FOUND:-}"; then
      echo "Error: $ref: not found" >&2; exit 1
    elif in_list "${FAKE_ORAS_UNKNOWN:-}"; then
      echo "Error: $ref: manifest unknown" >&2; exit 1
    elif in_list "${FAKE_ORAS_DENIED:-}"; then
      echo "Error response from registry: denied: requested access to the resource is denied" >&2; exit 1
    elif in_list "${FAKE_ORAS_BROKEN:-}"; then
      echo "Error: dial tcp: connection refused" >&2; exit 2
    fi
    mkdir -p "$out"; cp "${FAKE_ORAS_STORE:?}/$pkg"/* "$out"/ ;;
  *) echo "stub oras: unrecognised call: $*" >&2; exit 1 ;;
esac
